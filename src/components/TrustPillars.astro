---
const pillars = [
  {
    title: "Your data stays put",
    description:
      "Operator runs inside your network. No multi-tenant cloud. Outbound HTTPS only after setup.",
    icon: "shield",
  },
  {
    title: "Tested before go-live",
    description:
      "30–50 business questions in your words. We prove ≥90% pass rate before your exec uses it.",
    icon: "check",
  },
  {
    title: "Metrics you can defend",
    description:
      "Margin, revenue, and returns are precalculated in wide tables — not invented by the agent at query time.",
    icon: "chart",
  },
];
---

<section class="border-y border-brand-border bg-brand-surface py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-brand-primary sm:text-3xl">
        Built for operators, not experimenters
      </h2>
      <p class="mt-3 text-brand-secondary">
        High-stakes answers need more than plugging ChatGPT into Postgres.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-3">
      {
        pillars.map((pillar) => (
          <div class="rounded-2xl border border-brand-border bg-brand-bg p-6 transition-colors duration-200 hover:border-slate-300">
            <div
              class="mb-4 inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-cta/10 text-brand-cta"
              aria-hidden="true"
            >
              {pillar.icon === "shield" && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              )}
              {pillar.icon === "check" && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <path d="M22 4 12 14.01l-3-3"></path>
                </svg>
              )}
              {pillar.icon === "chart" && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 3v18h18"></path>
                  <path d="m19 9-5 5-4-4-3 3"></path>
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-brand-primary">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-secondary">{pillar.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
