---
import PillBadge from "./PillBadge.astro";
import VideoPlaceholder from "./VideoPlaceholder.astro";
import IntakeFormCta from "./IntakeFormCta.astro";
import {
  heroEyebrow,
  heroSecondaryLine,
  readinessCheckUrl,
} from "../config/site";
---

<section class="relative overflow-hidden pt-28 pb-16 sm:pt-32 sm:pb-24">
  <div class="gradient-blob pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-cta">
          {heroEyebrow}
        </p>
        <h1
          class="mt-3 text-4xl font-bold tracking-tight text-brand-primary sm:text-5xl lg:text-[3.25rem] lg:leading-[1.1]"
        >
          Ask your business data questions in plain English, privately.
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-brand-secondary">
          AI analytics on your infrastructure. Your data never leaves. Answers
          tested before go-live.
        </p>

        <div class="mt-8">
          <IntakeFormCta />
          <p class="mt-4 text-sm text-brand-muted">
            {heroSecondaryLine} ·
            <a
              href={readinessCheckUrl}
              class="font-medium text-brand-cta underline-offset-2 hover:underline"
            >
              Schema export help
            </a>
          </p>
        </div>
      </div>

      <VideoPlaceholder />
    </div>
  </div>
</section>
