---
const items = [
  "Data stays on your infrastructure",
  "Free check: schema upload only",
  "Setup: read-only access to your database",
  "No credit card · No commitment",
];
---

<section class="border-y border-brand-border bg-brand-bg py-10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <ul class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap sm:gap-x-10 sm:gap-y-3">
      {
        items.map((item) => (
          <li class="flex items-center gap-2 text-sm font-medium text-brand-secondary">
            <svg
              class="h-4 w-4 shrink-0 text-brand-cta"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</section>
