---
import { marketingDemoTitle, marketingDemoYoutubeId } from "../config/site";

const embedSrc = `https://www.youtube-nocookie.com/embed/${marketingDemoYoutubeId}`;
---

<div
  id="video"
  class="relative aspect-video w-full overflow-hidden rounded-2xl border border-brand-border bg-brand-surface shadow-lg shadow-slate-900/5"
>
  <iframe
    class="absolute inset-0 h-full w-full"
    src={embedSrc}
    title={marketingDemoTitle}
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
  >
  </iframe>
</div>
