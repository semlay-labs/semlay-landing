---
const description =
  "COO, CFO, and VP Operations at growing companies (20 to 200 employees) with a system of record (ERP, ecommerce platform, POS, or practice management software) who want plain-English access to operations and finance data without hiring a BI team.";
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl rounded-2xl border border-brand-border bg-brand-surface p-8 sm:p-10">
      <h2 class="text-xl font-bold tracking-tight text-brand-primary sm:text-2xl">
        Who this is for
      </h2>
      <p class="mt-4 leading-relaxed text-brand-secondary">{description}</p>
    </div>
  </div>
</section>
