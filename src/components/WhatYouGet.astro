---
const items = [
  {
    title: "Readiness Score (0 to 100)",
    description:
      "Across joinability, column clarity, entity coverage, and schema completeness",
  },
  {
    title: "Clear verdict",
    description: "Ready, Needs prep, or what's blocking you",
  },
  {
    title: "Setup recommendation",
    description: "Scoped tier and price if your data is ready",
  },
  {
    title: "Your questions referenced",
    description:
      "We'll scope setup around the business questions you care about",
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-bold tracking-tight text-brand-primary sm:text-3xl">
        What you get (free report)
      </h2>
      <p class="mt-3 text-brand-secondary">
        Even if your data isn't ready yet, you'll get an actionable checklist,
        not a sales pitch.
      </p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        items.map((item) => (
          <li class="rounded-2xl border border-brand-border bg-brand-surface p-6">
            <h3 class="font-semibold text-brand-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-secondary">
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
