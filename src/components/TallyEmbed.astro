---
interface Props {
  formUrl: string;
  title?: string;
}

const { formUrl, title = "Semlay readiness check intake form" } = Astro.props;

const embedSrc = new URL(formUrl);
embedSrc.searchParams.set("transparentBackground", "1");
embedSrc.searchParams.set("dynamicHeight", "1");
embedSrc.searchParams.set("hideTitle", "1");
---

<div class="tally-embed w-full">
  <iframe
    data-tally-src={embedSrc.toString()}
    loading="lazy"
    width="100%"
    height="2400"
    frameborder="0"
    marginheight="0"
    marginwidth="0"
    title={title}
    class="block w-full max-w-none rounded-2xl border border-brand-border bg-brand-surface shadow-sm"
  ></iframe>
</div>
<script is:inline>
  var d = document,
    w = "https://tally.so/widgets/embed.js",
    v = function () {
      if (typeof Tally !== "undefined") Tally.loadEmbeds();
      else
        d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(function (e) {
          e.src = e.dataset.tallySrc;
        });
    };
  if (typeof Tally !== "undefined") v();
  else if (d.querySelector('script[src="' + w + '"]') == null) {
    var s = d.createElement("script");
    s.src = w;
    s.onload = v;
    s.onerror = v;
    d.body.appendChild(s);
  }
</script>
